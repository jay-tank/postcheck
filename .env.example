# Copy to .env and fill in as needed. postcheck reads keys from the environment only.
# .env is git-ignored. NEVER commit real keys.
# Only used when --ai is passed — the structural lint itself never needs any of this.

# Default provider: claude | openai | ollama | mock
POSTCHECK_PROVIDER=claude

# Optional model override
# POSTCHECK_MODEL=claude-opus-4-8

# Provider credentials (only the one you use)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Ollama endpoint (if not default)
# OLLAMA_HOST=http://localhost:11434
